theorem C2_m111 : ¬ ∀ m d : ℝ, Poly4 (111/2000 : ℝ) (11/4 : ℝ) m d → G4 (111/2000 : ℝ) (11/4 : ℝ) (1848029/2500000 : ℝ) m d ≤ (1 - (1848029/2500000 : ℝ)) * (1 - (111/1000 : ℝ)) := by
  intro h
  have := h _ _ wp_m111_C2
  norm_num at this
  linarith [w_m111_C2]

end SS5
