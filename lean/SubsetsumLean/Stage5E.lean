/-- Row R1: pieces of [0, 1/2]. -/
theorem half_R1 : ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 / 2 → Covered R_R1 κ := by
  intro κ h0 h1
  have hl3 : log 3 / log 2 ≤ ((R_R1.l3 : ℚ) : ℝ) := by
    have e : R_R1.l3 = (39624062518029/25000000000000 : ℚ) := by decide +kernel
    rw [e]; push_cast; exact log2_3_le5
  have e0 : ((Q 0 1 : ℚ) : ℝ) = 0 := by norm_num [Q]
  have e1 : ((Q 1 2 : ℚ) : ℝ) = 1 / 2 := by norm_num [Q]
  have c0 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (9421) 20000) PS_R1_0 (Q (0) 1) chk_R1_0 ne_R1_0
  have c1 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (9451) 20000) PS_R1_1 (Q (9421) 20000) chk_R1_1 ne_R1_1
  have c2 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (9481) 20000) PS_R1_2 (Q (9451) 20000) chk_R1_2 ne_R1_2
  have c3 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (19063) 40000) PS_R1_3 (Q (9481) 20000) chk_R1_3 ne_R1_3
  have c4 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (19183) 40000) PS_R1_4 (Q (19063) 40000) chk_R1_4 ne_R1_4
  have c5 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (19303) 40000) PS_R1_5 (Q (19183) 40000) chk_R1_5 ne_R1_5
  have c6 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (19497) 40000) PS_R1_6 (Q (19303) 40000) chk_R1_6 ne_R1_6
  have c7 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (19813) 40000) PS_R1_7 (Q (19497) 40000) chk_R1_7 ne_R1_7
  have c8 := chk_sound R_R1 hslo_R1 hl3 rowok_R1 (Q (1) 2) PS_R1_8 (Q (19813) 40000) chk_R1_8 ne_R1_8
  rcases le_total κ (((Q (9421) 20000) : ℚ) : ℝ) with hc0 | hc0
  · exact c0 κ (by rw [e0]; exact h0) hc0
  rcases le_total κ (((Q (9451) 20000) : ℚ) : ℝ) with hc1 | hc1
  · exact c1 κ hc0 hc1
  rcases le_total κ (((Q (9481) 20000) : ℚ) : ℝ) with hc2 | hc2
  · exact c2 κ hc1 hc2
  rcases le_total κ (((Q (19063) 40000) : ℚ) : ℝ) with hc3 | hc3
  · exact c3 κ hc2 hc3
  rcases le_total κ (((Q (19183) 40000) : ℚ) : ℝ) with hc4 | hc4
  · exact c4 κ hc3 hc4
  rcases le_total κ (((Q (19303) 40000) : ℚ) : ℝ) with hc5 | hc5
  · exact c5 κ hc4 hc5
  rcases le_total κ (((Q (19497) 40000) : ℚ) : ℝ) with hc6 | hc6
  · exact c6 κ hc5 hc6
  rcases le_total κ (((Q (19813) 40000) : ℚ) : ℝ) with hc7 | hc7
  · exact c7 κ hc6 hc7
  exact c8 κ hc7 (by rw [e1]; exact h1)

/-- [E] row R1 (claim 2497527357/5000000000 = 0.4995054714): P1 = mu, P5 = Pscan = 2 mu, Kenum = mu (2 + lambda) are
at most the claim, and every layer kappa in [0, 1] has a menu design with P3, P4, P6 at most the claim. -/
theorem E_R1 : ((R_R1.μ : ℚ) : ℝ) ≤ R_R1.claim ∧ 2 * ((R_R1.μ : ℚ) : ℝ) ≤ R_R1.claim ∧
    ((R_R1.μ : ℚ) : ℝ) * (2 + R_R1.lam) ≤ R_R1.claim ∧ ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 → Covered R_R1 κ := by
  have h := rowok_R1
  simp only [Row.ok, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨-, -⟩, -⟩, c1⟩, c2⟩, c3⟩ := h
  refine ⟨by exact_mod_cast c1, by exact_mod_cast c2, by exact_mod_cast c3, ?_⟩
  exact row_covered R_R1 (by decide +kernel) (by decide +kernel) half_R1

