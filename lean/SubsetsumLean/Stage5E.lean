/-! ## [LAM] lambda for every design -/

/-- DERIVATION Lemma 3.3: for every core size, `(a_b + 1)(b_b + 1) ≤ (N_b/4 + 1)^2` when `a_b + b_b = N_b/2`, so
lambda ≤ 23983/1000000000000 at N_b = 8000000000 for every design (the core-free one included). -/
theorem lam5 : ∀ ab bb : ℝ, 0 ≤ ab → 0 ≤ bb → ab + bb = (4000000000 : ℝ) → lamR (8000000000 : ℝ) ab bb ≤ (23983/1000000000000 : ℝ) := by
  intro ab bb ha hb hsum
  have hP : (ab + 1) * (bb + 1) ≤ (2000000001 : ℝ) ^ 2 := by nlinarith [sq_nonneg (ab - bb)]
  have hpos : 0 < (ab + 1) * (bb + 1) := by positivity
  have hl : log ((ab + 1) * (bb + 1)) ≤ 2 * log (2000000001 : ℝ) := by
    have := Real.log_le_log hpos hP
    rw [Real.log_pow] at this
    push_cast at this
    exact this
  have h1 := (SS.log_mem (8000000000 : ℝ) (8000000000 : ℚ) (22802707378626247084413619456533/1000000000000000000000000000000 : ℚ) (11401353689313123542206809728267/500000000000000000000000000000 : ℚ) (33) 50 _ _ (by norm_num) rfl rfl (by decide +kernel))
  have h2 := (SS.log_mem (1 + (8000000000 : ℝ) * (346573590279972654708616060729088284037750567/500000000000000000000000000000000000000000000 : ℝ)) (346573590342472654708616060729088284037750567/62500000000000000000000000000000000 : ℚ) (22436194458224919637496040028399/1000000000000000000000000000000 : ℚ) (4487238891644983927499208005941/200000000000000000000000000000 : ℚ) (32) 50 _ _ (by norm_num) rfl rfl (by decide +kernel))
  have h3 := (SS.log_mem (2000000001 : ℝ) (2000000001 : ℚ) (21416413018006356465454155213659/1000000000000000000000000000000 : ℚ) (1070820650900317823272707760683/50000000000000000000000000000 : ℚ) (31) 50 _ _ (by norm_num) rfl rfl (by decide +kernel))
  have L := log2_bounds
  have hL : (0 : ℝ) < log 2 := Real.log_pos one_lt_two
  have hx : (0 : ℝ) < 1 + (8000000000 : ℝ) * log 2 := by positivity
  push_cast at h1 h2 h3
  have m2 : log (1 + (8000000000 : ℝ) * log 2) ≤ log (1 + (8000000000 : ℝ) * (346573590279972654708616060729088284037750567/500000000000000000000000000000000000000000000 : ℝ)) :=
    Real.log_le_log hx (by linarith [L.2])
  have p1 : (0 : ℝ) ≤ log (8000000000 : ℝ) := Real.log_nonneg (by norm_num)
  have p2 : (0 : ℝ) ≤ log (1 + (8000000000 : ℝ) * log 2) := Real.log_nonneg (by linarith [L.1])
  have p3 : (0 : ℝ) ≤ log (2000000001 : ℝ) := Real.log_nonneg (by norm_num)
  have d1 := div_le_div₀ (by linarith [h1.1, p1]) h1.2 (by norm_num) L.1
  have d2 := div_le_div₀ (by linarith [h2.1, p2, m2]) (m2.trans h2.2) (by norm_num) L.1
  have d3 : log ((ab + 1) * (bb + 1)) / log 2 ≤ (2 * (1070820650900317823272707760683/50000000000000000000000000000 : ℝ)) / (346573590279972654708616060729088284037749567/500000000000000000000000000000000000000000000 : ℝ) :=
    div_le_div₀ (by norm_num) (hl.trans (by linarith [h3.2])) (by norm_num) L.1
  unfold lamR
  rw [div_le_iff₀ (by norm_num)]
  norm_num at d1 d2 d3 ⊢
  linarith

/-- Every alpha of every row makes `a_b = alpha N_b/2` and `s a_b` integral for every circuit (Lemma 3.3). -/
theorem ab_integral : ∀ a ∈ [(Q (0) 1), (Q (1) 20), (Q (1) 10), (Q (3) 20), (Q (1) 5), (Q (1) 4), (Q (3) 10), (Q (7) 20), (Q (2) 5), (Q (9) 20), (Q (1) 2), (Q (11) 20), (Q (3) 5), (Q (13) 20), (Q (7) 10), (Q (3) 4), (Q (4) 5), (Q (17) 20), (Q (9) 10), (Q (23) 25), (Q (19) 20), (Q (97) 100)], ((8000000000 : ℚ) * a / 2).den = 1 ∧
    ∀ c ∈ [C_s11, C_m80, C_m95, C_m104, C_m111, C_m118, C_s8, C_m145], ((8000000000 : ℚ) * a / 2 * c.s).den = 1 := by decide +kernel

/-- Lemma 3.5''s window `s rho < 1/2` for all seven menu circuits and both family rho values. -/
theorem window : ∀ p ∈ [((Q (2) 25), (Q (57) 20)), ((Q (19) 200), (Q (14) 5)), ((Q (13) 125), (Q (11) 4)), ((Q (111) 1000), (Q (11) 4)), ((Q (59) 500), (Q (27) 10)), ((Q (1) 8), (Q (27) 10)), ((Q (29) 200), (Q (53) 20)), ((Q (11) 100), (Q (49) 20)), ((Q (11) 100), (Q (11) 4))],
    p.1 * p.2 < 1 / 2 := by decide +kernel

