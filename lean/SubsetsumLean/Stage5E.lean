/-- K7: R3 with the family point replaced by the single 11/100 circuit's (l, r) fails R3's claim (target 4989524521/10000000000 = 0.4989524521); at kappa = 498239447/1000000000 no design of the
menu meets it, for any w and any lambda ≥ 0. -/
theorem K7 : ∀ lam : ℝ, 0 ≤ lam → ¬ ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 → CoveredL R_K7 lam κ := by
  intro lam hlam h
  refine refute_alphas R_K7 hshi_K7 (Q (498239447) 1000000000) ?_ lam hlam (h _ (by norm_num [Q]) (by norm_num [Q]))
  intro a ha
  have e : R_K7.alphas = [(Q (0) 1), (Q (1) 10), (Q (1) 5), (Q (3) 10), (Q (2) 5), (Q (1) 2), (Q (3) 5), (Q (7) 10), (Q (4) 5), (Q (9) 10), (Q (23) 25)] := by decide +kernel
  rw [e] at ha
  simp only [List.mem_cons, List.not_mem_nil, or_false] at ha
  rcases ha with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [⟨_, _, ref_K7_0⟩, ⟨_, _, ref_K7_1⟩, ⟨_, _, ref_K7_2⟩, ⟨_, _, ref_K7_3⟩, ⟨_, _, ref_K7_4⟩, ⟨_, _, ref_K7_5⟩, ⟨_, _, ref_K7_6⟩, ⟨_, _, ref_K7_7⟩, ⟨_, _, ref_K7_8⟩, ⟨_, _, ref_K7_9⟩, ⟨_, _, ref_K7_10⟩]

/-- Control K3: no cores anywhere (the dedupe alone): at kappa = 1/2 every core-free design has P3 ≥ 1/2, for any
lambda ≥ 0, w and circuits. -/
theorem K3 : ∀ lam : ℝ, 0 ≤ lam → ∀ (c1 c2 : Circ) (w : ℝ), 1 / 2 ≤ P3v R_R2.μ lam R_R2.j R_R2.osv ((0 : ℚ) : ℝ) c1.s c1.l c1.r
    c2.s c2.l c2.r w (Hb (1 / 2)) (Hb (t5R ((0 : ℚ) : ℝ) c1.s c2.s (1 / 2))) (Hb c1.s) (Hb c2.s) := by
  intro lam hlam c1 c2 w
  have e1 : R_R2.μ = (201/1000 : ℚ) := by decide +kernel
  have e2 : R_R2.osv = (0 : ℚ) := by decide +kernel
  rw [Rat.cast_zero, t5R_zero, Hb_half]
  exact P3v_half_ge _ _ _ _ _ _ _ _ _ _ _ _ _ (by rw [e1]; norm_num) hlam (by rw [e2]; norm_num)

/-- Control K8: R1b's two blocks per side no longer fit at mu = 201/1000: `j mu ≤ (1 - mu)(1/2 - |w|)` fails for every w. -/
theorem K8 : ∀ w : ℝ, ¬ ((2 : ℝ) * (201 / 1000) ≤ (1 - 201 / 1000) * (1 / 2 - |w|)) := by
