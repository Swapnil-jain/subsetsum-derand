/-!
# Stage 5b kernel check of row R4b-min and its controls (generated by `gen_stage5b.py`)

`E_R4bmin`: every layer kappa in [0, 1] is served by a menu design whose P3, P4, P6 are at most the claim, and the
constant terms are too; `K*`: the must-fail controls of `cert_stage5b.py`, each proved false.
-/

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

open Real

namespace SS5b

open SS SS4 SS5


/-- Every alpha of R4b-min makes `a_b = alpha N_b/2` and `s a_b` integral for every circuit (Stage 5 Lemma 3.3). -/
theorem ab_integral5b : ∀ a ∈ [(Q (0) 1), (Q (1) 10), (Q (1) 5), (Q (3) 10), (Q (2) 5), (Q (1) 2), (Q (3) 5), (Q (7) 10), (Q (4) 5), (Q (9) 10), (Q (93) 100), (Q (19) 20), (Q (24) 25), (Q (97) 100), (Q (49) 50), (Q (99) 100)], ((8000000000 : ℚ) * a / 2).den = 1 ∧
    ∀ c ∈ [C_m80, C_m95, C_f104, C_f111, C_f118, C_f125, C_f145, C_f110], ((8000000000 : ℚ) * a / 2 * c.s).den = 1 := by decide +kernel

/-- Stage 4 Lemma 3.5''s window `s rho < 1/2` for every member of the six families. -/
theorem window5b : ∀ p ∈ [((Q (13) 125), (Q (12) 5)), ((Q (13) 125), (Q (51) 20)), ((Q (13) 125), (Q (11) 4)), ((Q (111) 1000), (Q (12) 5)), ((Q (111) 1000), (Q (51) 20)), ((Q (111) 1000), (Q (11) 4)), ((Q (59) 500), (Q (12) 5)), ((Q (59) 500), (Q (51) 20)), ((Q (59) 500), (Q (11) 4)), ((Q (1) 8), (Q (12) 5)), ((Q (1) 8), (Q (51) 20)), ((Q (1) 8), (Q (11) 4)), ((Q (29) 200), (Q (49) 20)), ((Q (29) 200), (Q (13) 5)), ((Q (29) 200), (Q (14) 5)), ((Q (11) 100), (Q (12) 5)), ((Q (11) 100), (Q (51) 20)), ((Q (11) 100), (Q (11) 4))], p.1 * p.2 < 1 / 2 := by decide +kernel

theorem hslo_R4bmin : ∀ c ∈ R_R4bmin.circs, ((c.hsLo : ℚ) : ℝ) ≤ Hb ((c.s : ℚ) : ℝ) := by
  intro c hc
  have e : R_R4bmin.circs = [C_m80, C_m95, C_f104, C_f111, C_f118, C_f125, C_f145, C_f110] := rfl
  rw [e] at hc
  simp only [List.mem_cons, List.not_mem_nil, or_false] at hc
  rcases hc with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [hb_C_m80.1, hb_C_m95.1, hb_C_f104.1, hb_C_f111.1, hb_C_f118.1, hb_C_f125.1, hb_C_f145.1, hb_C_f110.1]

/-- Row R4b-min: pieces of [0, 1/2]. -/
theorem half_R4bmin : ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 / 2 → Covered R_R4bmin κ := by
  intro κ h0 h1
  have hl3 : log 3 / log 2 ≤ ((R_R4bmin.l3 : ℚ) : ℝ) := by
    have e : R_R4bmin.l3 = (39624062518029/25000000000000 : ℚ) := by decide +kernel
    rw [e]; push_cast; exact log2_3_le5
  have e0 : ((Q 0 1 : ℚ) : ℝ) = 0 := by norm_num [Q]
  have e1 : ((Q 1 2 : ℚ) : ℝ) = 1 / 2 := by norm_num [Q]
  have c0 := chk_sound R_R4bmin hslo_R4bmin hl3 rowok_R4bmin (Q (1) 2) PS_R4bmin_0 (Q (0) 1) chk_R4bmin_0 ne_R4bmin_0
  exact c0 κ (by rw [e0]; exact h0) (by rw [e1]; exact h1)

/-- [E] row R4b-min, Theorem 5b-F (claim 77910909/156250000 = 0.4986298176): P1 = mu, P5 = Pscan = 2 mu,
Kenum = mu (2 + lambda) are at most the claim, and every layer kappa in [0, 1] has a menu design with P3, P4, P6 at
most the claim. The menu: the six families (`fam_*`) and Stage 5's circuits at 2/25 and 19/200. -/
theorem E_R4bmin : ((R_R4bmin.μ : ℚ) : ℝ) ≤ R_R4bmin.claim ∧ 2 * ((R_R4bmin.μ : ℚ) : ℝ) ≤ R_R4bmin.claim ∧
    ((R_R4bmin.μ : ℚ) : ℝ) * (2 + R_R4bmin.lam) ≤ R_R4bmin.claim ∧ ∀ κ : ℝ, 0 ≤ κ → κ ≤ 1 → Covered R_R4bmin κ := by
  have h := rowok_R4bmin
  simp only [Row.ok, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨-, -⟩, -⟩, c1⟩, c2⟩, c3⟩ := h
  refine ⟨by exact_mod_cast c1, by exact_mod_cast c2, by exact_mod_cast c3, ?_⟩
  exact row_covered R_R4bmin (by decide +kernel) (by decide +kernel) half_R4bmin

